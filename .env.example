# LTBackend API base URL (Django). Copy to .env.local to override.
# Local:      http://localhost:8000/api/v1
# Production: https://api.loveandtails.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Show the puppy "we're building" page on every route.
# Unset: on in production builds, off in dev. Set to false to launch.
# VITE_UNDER_CONSTRUCTION=true
